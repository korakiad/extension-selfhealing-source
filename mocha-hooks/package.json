{
  "name": "@qa-debug/mocha-hooks",
  "version": "0.0.0",
  "private": true,
  "description": "Mocha root hook plugin (qa-hooks.cjs) and shared IPC protocol module. Per ARCHITECTURE v4 §3.1 and §3.5.",
  "main": "dist/qa-hooks.js",
  "exports": {
    ".": { "types": "./src/qa-hooks.ts", "default": "./dist/qa-hooks.js" },
    "./protocol": { "types": "./src/protocol.ts", "default": "./dist/protocol.js" },
    "./probe": { "types": "./src/probe.ts", "default": "./dist/probe.js" },
    "./register": { "types": "./src/qa-hooks.ts", "default": "./dist/qa-hooks.js" },
    "./qa-reporter": { "types": "./src/qa-reporter.ts", "default": "./dist/qa-reporter.js" }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm run test:unit:protocol && pnpm run test:unit:heartbeat",
    "test:unit:protocol": "node --import tsx test/protocol.test.mts",
    "test:unit:heartbeat": "node --import tsx test/heartbeat.test.mts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.7.3",
    "typescript": "^5.7.2"
  }
}
