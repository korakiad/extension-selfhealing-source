{
  "name": "qa-debug-companion",
  "displayName": "QA Debug Companion",
  "version": "0.0.0",
  "private": true,
  "description": "Holds Mocha on test failure with browser alive; surfaces playwright-mcp + qa-debug skill to Copilot. Phase 1.",
  "publisher": "qa-debug",
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "chatSkills": [
      { "path": "./skills/qa-debug/SKILL.md" }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "qa-debug.mcp-servers",
        "label": "QA Debug Companion MCP Servers"
      }
    ],
    "chatParticipants": [
      {
        "id": "qa-debug",
        "name": "qa-debug",
        "fullName": "QA Debug Companion",
        "description": "Investigates a paused Mocha test failure with live browser access via playwright-mcp.",
        "isSticky": true,
        "disambiguation": [
          {
            "category": "qa-debug-pause-investigation",
            "description": "Investigating a paused Mocha test failure where the browser is held alive for live inspection.",
            "examples": [
              "the test just failed, what's going on",
              "this assertion's wrong, can you look",
              "I think the selector changed",
              "help me debug this paused test"
            ]
          }
        ]
      }
    ],
    "commands": [
      { "command": "qa-debug.runFixture", "title": "QA Debug: Run Fixture Suite", "category": "QA Debug" },
      { "command": "qa-debug.retry", "title": "QA Debug: Retry Paused Test", "category": "QA Debug", "enablement": "qa-debug.paused" },
      { "command": "qa-debug.markPassed", "title": "QA Debug: Mark Paused Test as Passed", "category": "QA Debug", "enablement": "qa-debug.paused" },
      { "command": "qa-debug.giveUp", "title": "QA Debug: Give Up on Paused Test", "category": "QA Debug", "enablement": "qa-debug.paused" },
      { "command": "qa-debug.smokeTestMessageRetention", "title": "QA Debug: Smoke — TestMessage Retention", "category": "QA Debug" }
    ],
    "menus": {
      "testing/message/content": [
        { "command": "qa-debug.retry",       "when": "testMessage == qaDebugPaused" },
        { "command": "qa-debug.markPassed",  "when": "testMessage == qaDebugPaused" },
        { "command": "qa-debug.giveUp",      "when": "testMessage == qaDebugPaused" }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qa-debug/mocha-hooks": "workspace:*",
    "@qa-debug/pause-store-types": "workspace:*",
    "@qa-debug/qa-debug-mcp": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
