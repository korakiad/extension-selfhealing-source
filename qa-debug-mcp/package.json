{
  "name": "@qa-debug/qa-debug-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "qa-debug MCP server — exposes the 6 qa_* tools. Library factory (`server.js`) + stdio CLI binary. The extension imports the library; the binary is for Inspector / evals smoke.",
  "bin": "./dist/qa-debug-mcp.js",
  "main": "./dist/server.js",
  "exports": {
    ".": { "types": "./src/server.ts", "default": "./dist/server.js" },
    "./server": { "types": "./src/server.ts", "default": "./dist/server.js" },
    "./pause-store": { "types": "./src/pause-store.ts", "default": "./dist/pause-store.js" }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qa-debug/mocha-hooks": "workspace:*",
    "@qa-debug/pause-store-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
